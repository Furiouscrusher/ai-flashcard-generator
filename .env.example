# AI Flashcard Generator Using RAG - Environment Configuration
# Add any of the following API keys (Mock mode is used automatically if none are provided)

# 1. Groq API Key (Recommended for ultra-fast generation & free tier)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. OpenRouter API Key (Multi-model access: DeepSeek, Llama 3, Claude, etc.)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# 3. Google Gemini API Key
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 4. OpenAI API Key
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ChromaDB Settings
CHROMA_PERSIST_DIR=./data/chroma_db
